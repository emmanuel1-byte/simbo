# Copy this file to .env and fill in the values before running docker compose up.

# ── Database ─────────────────────────────────────────────────────────────────
# Password for the PostgreSQL superuser. Used by both the db and app services.
POSTGRES_PASSWORD=changeme
POSTGRES_USER=simbo
POSTGRES_DB=simbo
DATABASE_URL=postgresql://simbo:changeme@localhost:5432/simbo?search_path=public&sslmode=disable

# ── App secrets ───────────────────────────────────────────────────────────────
# Generate both with: openssl rand -base64 32
JWT_ACCESS_SECRET=changeme
ENCRYPTION_KEY=changeme

# ── Transactional email (optional) ───────────────────────────────────────────
# Plunk public key for sending OTP / verification emails.
# Leave blank to disable email sending.
USEPLUNK_PUBLIC_KEY=

# ── Ports (defaults shown) ───────────────────────────────────────────────────
APP_FRONTEND_PORT=3000
APP_BACKEND_PORT=9090
DB_PORT=5433

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the browser may call the API from.
CORS_ORIGINS=http://localhost:3000

# ── Next.js build arg ────────────────────────────────────────────────────────
# Baked into the JS bundle at image build time — must match your public URL.
NEXT_PUBLIC_API_URL=http://localhost:9090/api
GEMINI_API_KEY=smaple