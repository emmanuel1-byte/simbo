# ─────────────────────────────────────────────────────────────
# Simbo FE — environment variables
# Copy this file to .env.local and adjust as needed.
# ─────────────────────────────────────────────────────────────

# Base URL of the NestJS backend API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# When true, the FE uses local mock responses instead of calling the backend.
# Useful while the BE endpoints are still being wired up.
# Set to "false" to point at the real API.
NEXT_PUBLIC_USE_MOCKS=true
